APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_BLOG_TABLE_ID=
APPWRITE_BLOG_BUCKET_ID=

# Server-only Appwrite key with rows and files read/write access.
APPWRITE_API_KEY=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_ADMIN_EMAIL=admin@example.com
BETTER_AUTH_ADMIN_USERNAME=admin
# Only needed while creating the initial administrator; remove it afterward.
BETTER_AUTH_SETUP_TOKEN=
